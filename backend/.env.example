# App
APP_ENV=development
# PostgreSQL + pgvector（推荐，先 docker compose up -d）
DATABASE_URL=postgresql+asyncpg://name:name@localhost:5432/name
# 无 Docker 时可改用 SQLite：
# DATABASE_URL=sqlite+aiosqlite:///./data/name.db
REDIS_URL=redis://localhost:6379/0
ADMIN_API_KEY=change-me-admin-key
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# WeChat (optional for MVP)
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# LLM (default DeepSeek)
LLM_MOCK=true
LLM_PROVIDER=deepseek
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-key
LLM_MODEL=deepseek-v4-flash
LLM_MODEL_FATE=
LLM_MODEL_COMPOSE=
LLM_MODEL_QA=
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.3
